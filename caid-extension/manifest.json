{
  "manifest_version": 3,
  "name": "CAID 程序员工作台",
  "version": "0.1.0",
  "description": "继承魔改版 Page-Agent 的程序员工作台：接管新标签页，并在任意网页提供跨页智能体副驾。",
  "permissions": ["storage", "scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "CAID 副驾：点击在 current page 启动"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://graduate.dpdns.org/*"],
      "js": ["caid-bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/zod-v4.umd.js", "lib/page-agent.headless.js", "caid-copilot.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "newtab.html#settings",
    "open_in_tab": true
  }
}
