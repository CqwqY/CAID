{
  "manifest_version": 3,
  "name": "CAID 程序员工作台",
  "version": "0.3.6",
  "description": "继承魔改版 Page-Agent 的程序员工作台：动态接管新标签页，并在任意网页提供跨页智能体副驾与轻量插件系统。",
  "permissions": ["storage", "scripting", "tabs", "activeTab", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-400.png",
    "32": "icons/icon-400.png",
    "48": "icons/icon-400.png",
    "128": "icons/icon-400.png"
  },
  "action": {
    "default_title": "CAID 副驾：点击在 current page 启动",
    "default_icon": {
      "16": "icons/icon-400.png",
      "32": "icons/icon-400.png",
      "48": "icons/icon-400.png",
      "128": "icons/icon-400.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/zod-v4.umd.js", "lib/page-agent.headless.js", "caid-copilot.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": ["sandbox/plugin-sandbox.html"]
  },
  "options_ui": {
    "page": "newtab.html#settings",
    "open_in_tab": true
  }
}
